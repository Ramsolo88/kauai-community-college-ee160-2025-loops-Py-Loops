# Task 3

original = 12
n = 1
change = original

while change >= 0.0001:
    current = original * (1/2**n)
    prev = original * (1/2**(n-1))
    change = abs (current - prev)
    n += 1
# While loop that tries dividing 12 by 2 multiple times to find min error

print(f" {n-1} times")
# Will print the number of times 12 was divided by 2 before reaching
# zero within a 0.0001 margin of error.
